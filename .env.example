# Public base URL of the MediDrone backend. Required at build time (NEXT_PUBLIC_*
# is inlined by Next.js) — never hardcode the URL in source code.
# No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
#
# Production example:
# NEXT_PUBLIC_API_BASE_URL=https://medihelp-production-35ca.up.railway.app
